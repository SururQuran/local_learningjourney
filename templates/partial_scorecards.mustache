{{!
    @template local_learningjourney/partial_scorecards

    Grid of result cards describing the attempt.

    Context variables required for this template:
    * cards array Result cards.
    * cards[].label string Card label.
    * cards[].value string Card value.
    * cards[].sublabel string Optional supplementary text.
    * cards[].hassublabel bool Whether supplementary text is present.

    Example context (json):
    {
        "cards": [
            {"label": "Final score", "value": "82 / 100", "sublabel": "Attempt 1", "hassublabel": true}
        ]
    }
}}
<dl class="ljy-cards">
    {{#cards}}
        <div class="ljy-card">
            <dt class="ljy-card__label">{{label}}</dt>
            <dd class="ljy-card__value">
                {{value}}
                {{#hassublabel}}<span class="ljy-card__sublabel">{{sublabel}}</span>{{/hassublabel}}
            </dd>
        </div>
    {{/cards}}
</dl>
