{{!
    @template local_learningjourney/partial_actions

    Button group rendering the ordered page actions. Every action is a real
    link, so keyboard and screen reader navigation work without any script.

    Context variables required for this template:
    * actions array Ordered page actions.
    * actions[].url string Destination of the action.
    * actions[].label string Visible label of the action.
    * actions[].primary bool Whether the action is the primary call to action.
    * actions[].id string Stable identifier used for testing and styling.

    Example context (json):
    {
        "actions": [
            {"url": "https://example.com/mod/page/view.php?id=9", "label": "Continue to Lesson 2", "primary": true, "id": "continue"},
            {"url": "https://example.com/course/view.php?id=2", "label": "Return to course", "primary": false, "id": "course"}
        ]
    }
}}
<nav class="ljy-actions">
    {{#actions}}
        <a class="ljy-action {{#primary}}ljy-action--primary{{/primary}}{{^primary}}ljy-action--ghost{{/primary}}"
           href="{{url}}"
           data-ljy-action="{{id}}">{{label}}</a>
    {{/actions}}
</nav>
